# Global / Root Environment Configuration Example
# Frontend runs on 5173, Backend on 5000

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL= https://myhealthio-backend.onrender.com/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myhealthio?schema=public"

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# AI Provider Configuration (Backend Only - Never expose to frontend)
AI_PROVIDER=template # Options: gemini | openai | anthropic | template
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
