generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  fullName            String
  mockAbhaId          String              @unique
  preferredLanguage   String              @default("en")
  dateOfBirth         DateTime?
  gender              String?
  bloodGroup          String              @default("O+")
  emergencyContact    String?             @default("")
  allergies           Json                @default("[]")
  chronicConditions   Json                @default("[]")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  reports             MedicalReport[]
  timelineEvents      TimelineEvent[]
  medicationAlarms    MedicationAlarm[]
  dietProfile         DietProfile?
  ambulanceDispatches AmbulanceDispatch[]
  appointments        Appointment[]
  notifications       Notification[]

  @@map("users")
}

model MedicalReport {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  filePath         String          @default("")
  mimeType         String          @default("application/pdf")
  fileSizeBytes    BigInt          @default(0)
  documentType     String          @default("LAB_REPORT")
  documentDate     DateTime        @default(now())
  facility         String          @default("Clinical Lab")
  extractedRawText String?         @db.Text
  processingStatus String          @default("COMPLETED")
  ocrConfidence    Float?          @default(95.0)
  flaggedCount     Int             @default(0)
  fields           Json            @default("[]")
  labs             Json            @default("[]")
  medications      Json            @default("[]")
  summary          Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  timelineEvents   TimelineEvent[]

  @@index([userId])
  @@map("medical_reports")
}

model TimelineEvent {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId       String?
  report         MedicalReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  eventDate      DateTime       @default(now())
  eventType      String         @default("LAB_REPORT")
  title          String
  summaryPreview String?        @db.Text
  severityLevel  String         @default("NORMAL")
  createdAt      DateTime       @default(now())

  @@index([userId, eventDate])
  @@map("timeline_events")
}

model MedicationAlarm {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineName      String
  dosage            String   @default("1 Tablet")
  frequency         String   @default("TWICE_DAILY")
  timings           Json     @default("[\"08:00\", \"20:00\"]")
  mealRelation      String   @default("AFTER_MEAL")
  instructions      String?  @default("")
  color             String?  @default("#0d9488")
  pillStock         Int      @default(30)
  lowStockThreshold Int      @default(5)
  active            Boolean  @default(true)
  intakeLogs        Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("medication_alarms")
}

model DietProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName                String
  planType                String   @default("BALANCED_WELLNESS")
  targetDailyCalories     Int      @default(1800)
  dailyWaterTargetGlasses Int      @default(8)
  waterLoggedGlasses      Int      @default(0)
  dietaryRestrictions     Json     @default("[]")
  meals                   Json     @default("[]")
  guidelines              Json     @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("diet_profiles")
}

model AmbulanceDispatch {
  id                        String   @id @default(uuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientName               String
  patientPhone              String
  bloodGroup                String   @default("O+")
  criticalConditions        Json     @default("[]")
  allergies                 Json     @default("[]")
  location                  Json
  severity                  String   @default("CRITICAL")
  ambulanceType             String   @default("ADVANCED_CARDIAC_ICU")
  status                    String   @default("DISPATCHED")
  hospitalDestination       String   @default("Apollo Emergency Medical Centre")
  ambulanceDetails          Json
  emergencyContactsNotified Boolean  @default(true)
  notes                     String?  @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId])
  @@map("ambulance_dispatches")
}

model Appointment {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName       String
  specialty        String   @default("General Medicine")
  clinicName       String
  date             String
  time             String
  type             String   @default("FOLLOW_UP")
  status           String   @default("UPCOMING")
  reasonForVisit   String   @db.Text
  doctorNotes      String?  @default("") @db.Text
  nextFollowUpDays Int?
  reminderSet      Boolean  @default(true)
  location         String   @default("Main Consultation Wing, Room 204")
  contactPhone     String?  @default("+91 40 2345 6789")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("appointments")
}

model FirstAidGuide {
  id                       String   @id @default(uuid())
  slug                     String   @unique
  title                    String
  category                 String
  severity                 String   @default("URGENT")
  summary                  String   @db.Text
  symptoms                 Json     @default("[]")
  steps                    Json     @default("[]")
  dos                      Json     @default("[]")
  donts                    Json     @default("[]")
  cprCadenceBpm            Int?
  callEmergencyImmediately Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("first_aid_guides")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM")
  priority  String   @default("NORMAL")
  read      Boolean  @default(false)
  actionUrl String?  @default("")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notifications")
}
